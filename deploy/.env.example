# Chép thành /opt/m22/app/.env trên server, chmod 600, chủ sở hữu m22. Không commit file .env thật.

# Thư mục bảng thật của dashboard (ngoài repo để git pull không đụng vào)
M22_REAL_DIR=/opt/m22/data_real

# Chỉ cần nếu chạy pipeline / CLI trên server
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
CVAT_SERVER_URL=https://app.cvat.ai
CVAT_USERNAME=
CVAT_PASSWORD=
