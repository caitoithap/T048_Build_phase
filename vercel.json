{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd dashboard/web && npm ci",
  "buildCommand": "cd dashboard/web && npm run build",
  "outputDirectory": "dashboard/web/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{dashboard/**,sample_data_output1/annotations.xml,sample_data_output1/images.zip}",
      "excludeFiles": "{dashboard/web/**,dashboard/views/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
